# ---- Application ----
APP_NAME=MealBridge AI
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
PROJECT_NAME=MealBridge-AI

# ---- Database (SQLite) ----
# Single .db file, stored in the backend directory.
DATABASE_URL=sqlite+aiosqlite:///./mealbridge.db
SYNC_DATABASE_URL=sqlite+aiosqlite:///./mealbridge.db

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- Auth / JWT ----
JWT_SECRET=change-me-in-production-to-a-64-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
# Comma-separated allow-list. In production this MUST NOT be *.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=60/minute

# ---- Geo ----
# USE_POSTGIS=true -> geography column + ST_DWithin queries (requires PostGIS)
# USE_POSTGIS=false -> bounding-box prefilter + Haversine in Python (SQLite default)
USE_POSTGIS=false
# Average city driving speed used for estimated pickup/travel time when no
# routing engine is available (km/h).
AVG_CITY_SPEED_KMH=30
MATCH_INITIAL_RADIUS_KM=5
MATCH_MAX_RADIUS_KM=25
MATCH_RADIUS_STEP_KM=5
MATCH_MIN_CANDIDATES=3
MATCH_MAX_ALTERNATIVES=4
# Weights for the ranking score (must sum to 1.0)
MATCH_W_DISTANCE=0.5
MATCH_W_CAPACITY=0.3
MATCH_W_RELIABILITY=0.2
# NGO response window before the request is auto-expired & re-offered (minutes)
NGO_RESPONSE_WINDOW_MINUTES=60
DONATION_EXPIRY_HOURS=12

# ---- Geocoding / Directions ----
# Provider: "google" or "nominatim"
GEOCODER_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=
# Provider: "osrm" or "straight_line"
DIRECTIONS_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org/route/v1

# ---- Object storage (S3-compatible) ----
# Provider: "local" (dev) or "s3"
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# ---- Notifications ----
EMAIL_PROVIDER=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MealBridge AI <no-reply@mealbridge.ai>
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Impact analytics ----
# Estimated kg of CO2e saved per kg of food rescued (documented estimate, not a
# precise measurement). 2.5 is a common midpoint for mixed food waste.
CO2_FACTOR_KG_PER_KG=2.5
# Average meal weight used to convert meals -> food weight (kg) for analytics
AVG_MEAL_WEIGHT_KG=0.45
# People served per meal rescued (used for People Served estimates on the NGO/
# donor dashboard stat cards)
PEOPLE_PER_MEAL=1.0

# ---- Seed ----
# Seeded admin credentials (created by scripts/seed.sh, not by API)
SEED_ADMIN_EMAIL=admin@mealbridge.ai
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CITY=Bengaluru
SEED_CITY_LAT=12.9716
SEED_CITY_LNG=77.5946
